---

---

<section class="login">
  <img class="logo" src="/public/logo.png" alt="Logo Clothing" />
  <h1>Welcome Back</h1>

  <input type="text" placeholder="User" />
  <input type="password" placeholder="Password" />

  <a class="boton verde" href="/categorias">Log in</a>
  <a class="boton gris" href="/categorias">
    <img src="/public/google.png" alt="Google" />
    Login with Google
  </a>
</section>

<style>
  .login {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem 3rem;
    box-sizing: border-box;
    height: 100%;
    background: white;
  }

  .logo {
    height: 60px;
    width: auto;
  }

  h1 {
    margin: 0 0 2rem 0;
    font-size: 1.6rem;
    font-weight: 500;
  }

  input {
    width: 100%;
    max-width: 320px;
    padding: 0.7rem;
    border: none;
    border-radius: 4px;
    background: #e8e8e8;
    box-sizing: border-box;
  }

  .boton {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 320px;
    padding: 0.7rem;
    border-radius: 4px;
    box-sizing: border-box;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .verde {
    margin-top: 2rem;
    background: #2e7d32;
    color: white;
  }

  .gris {
    background: #ececec;
    color: #444;
    border: 1px solid #d4d4d4;
  }

  .gris img {
    height: 16px;
    width: auto;
  }
</style>
