<section class="banner">
  <img src="/cabecera.jpg" alt="Rebajas mujer" />
  <div class="texto">
    <h1>REBAJAS</h1>
    <p class="subtitulo">MIRTO MUJER</p>
    <p class="descuentos">-10% -20% -30% -40% -50%</p>
  </div>
</section>

<style>
  .banner {
    position: relative;
    height: 400px;
    overflow: hidden;
  }

  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .texto {
    position: absolute;
    left: 0;
    bottom: 40px;
    width: 100%;
    text-align: center;
    color: white;
  }

  h1 {
    margin: 0;
    font-size: 64px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .subtitulo {
    margin: 0.3rem 0 1.5rem 0;
    font-size: 1.3rem;
    font-weight: 300;
    font-style: italic;
  }

  .descuentos {
    margin: 0;
    font-size: 1.8rem;
  }
</style>
