<header>
  <nav>
    <a class="activo" href="#">HOME</a>
    <a href="#">SHOP</a>
  </nav>

  <div class="usuario">
    <span>User_name</span>
    <div class="avatar"></div>
  </div>
</header>

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    box-sizing: border-box;
    z-index: 2;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  nav a {
    color: #444;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    padding-bottom: 2px;
  }

  .activo {
    border-bottom: 2px solid #444;
  }

  .usuario {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #555;
    font-size: 0.8rem;
  }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #d9d9d9;
    border: 1px solid #bbb;
  }
</style>
